{
  "name": "english-lessons",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 4000",
    "predev": "wrangler d1 migrations apply english-lessons --local",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply english-lessons --local",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types",
    "mock:ai": "node scripts/mock-ai.mjs",
    "vocab": "node scripts/build-vocabulary.mjs",
    "vocab:curate": "node scripts/curate-vocabulary.mjs",
    "icons": "node scripts/icons.mjs",
    "og": "node scripts/og.mjs",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.workers.config.ts && pnpm --filter chrome-extension test",
    "test:unit": "vitest run",
    "test:db": "vitest run -c vitest.workers.config.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "ext:build": "pnpm --filter chrome-extension build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "sharp": "^0.35.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "better-sqlite3",
      "sharp",
      "workerd"
    ]
  }
}